# GalloTrack — environment variables
# Copy to `.env.local` (git-ignored) and fill in the values from your Supabase
# project: Project Settings → API. Nothing else needs changing for a new host.

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-only: used by the admin API routes (audit logs,
# system settings, user administration). NEVER expose it to the browser and
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical URL of this deployment. Supabase auth emails and redirects use it,
# so it must match the public origin (http://localhost:3000 in development).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Local tooling (optional) ─────────────────────────────────────────────────
# Base URL used by the smoke-test runner. Defaults to http://localhost:3000.
# SMOKE_API_BASE=http://localhost:3000
