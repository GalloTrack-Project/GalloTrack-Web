{
  "framework": "nextjs",
  "rewrites": [
    { "source": "/dashboard", "destination": "/" },
    { "source": "/profiling", "destination": "/" },
    { "source": "/marketplace", "destination": "/" },
    { "source": "/((?!api|_next/static|_next/image|favicon.ico|profile|settings|auth/confirm|auth/update-password|register|auth/verify-otp|admin).*)", "destination": "/" }
  ]
}
